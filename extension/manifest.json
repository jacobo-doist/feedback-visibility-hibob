{
  "manifest_version": 3,
  "name": "Feedback Visibility Default for HiBob",
  "short_name": "Feedback Visibility",
  "version": "1.0.0",
  "description": "Pre-selects 'Employee and manager' in HiBob's 'Who will see this feedback?' field.",
  "homepage_url": "https://github.com/jacobo-doist/feedback-visibility-hibob",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://app.hibob.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
